#include <iostream>
#include <string>
#include <vector>
#include <map>

using namespace std;

struct Student {
    string name;
    string enrollmentID;
    bool google2FA;
    bool otpVerified;
    string opinion;
};

struct Node {
    string position;
    vector<Student> students;
    Node* left;
    Node* right;
    
    Node(string pos) {
        position = pos;
        left = nullptr;
        right = nullptr;
    }
};

class DigitalBallotSystem {
    Node* root;
    map<string, Student> registeredStudents;

public:
    DigitalBallotSystem() {
        root = new Node("Voting Authority");
    }

    void addDepartment(string departmentName, vector<Student> deptStudents) {
        Node* departmentNode = new Node(departmentName);
        departmentNode->students = deptStudents;
        if (!root->left) {
            root->left = departmentNode;
        } else if (!root->right) {
            root->right = departmentNode;
        }
    }

    void registerStudent(Student s) {
        if (s.google2FA && s.otpVerified) {
            registeredStudents[s.enrollmentID] = s;
        }
    }

    void submitForm(string enrollmentID, string opinion) {
        if (registeredStudents.find(enrollmentID) != registeredStudents.end()) {
            registeredStudents[enrollmentID].opinion = opinion;
        }
    }

    void displayResults() {
        for (auto& entry : registeredStudents) {
            cout << "Student ID: " << entry.first << " | Opinion: " << entry.second.opinion << endl;
        }
    }
};

int main() {
    DigitalBallotSystem dbs;

    Student s1 = {"Parth Pariwandh", "JU2023ME001", true, true, ""};
    Student s2 = {"Kamara Harshvardhan", "UOH2023DS002", true, true, ""};

    vector<Student> mechJU = {s1};
    vector<Student> dataUOH = {s2};

    dbs.addDepartment("Mechanical Engineering - Jadavpur University", mechJU);
    dbs.addDepartment("Data Science - University of Hyderabad", dataUOH);

    dbs.registerStudent(s1);
    dbs.registerStudent(s2);

    dbs.submitForm("JU2023ME001", "Strongly Support Institutional Digital Elections");
    dbs.submitForm("UOH2023DS002", "Recommend Biometric Integration for Verification");

    dbs.displayResults();

    return 0;
}
